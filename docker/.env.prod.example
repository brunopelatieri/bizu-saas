# Variáveis do docker/compose.prod.yml (stack de produção). Copie para docker/.env.prod, que o
# git ignora, e preencha. Só este arquivo é versionado, com valores de exemplo.
#
#   cp docker/.env.prod.example docker/.env.prod
#   docker compose --env-file docker/.env.prod -f docker/compose.prod.yml config   # confere tudo
#
# No Portainer, cole estas variáveis na seção "Environment variables" da stack.
#
# O app RECUSA subir em produção com os valores de exemplo de BETTER_AUTH_SECRET,
# CREDENTIALS_ENCRYPTION_KEY e AUDIT_SALT (qualquer valor que comece por `change-me`), com
# RATE_LIMIT_STORE=memory ou com EMAIL_PROVIDER=memory. Gere valores novos para tudo que está
# marcado como OBRIGATÓRIO e GERE.
#
# Senhas entram em URLs de conexão: use só letras e números (`openssl rand -hex 24`). As senhas de
# bizu_owner, bizu_app e bizu_backup que começam por `change-me` ou têm menos de 16 caracteres são
# recusadas (o init do banco falha e o app não sobe). Troque também a do superusuário: ela não é
# verificada.

# --- Domínio e proxy (OBRIGATÓRIO) ---------------------------------------------
# Domínio servido pelo Caddy, que obtém o certificado sozinho. O DNS precisa apontar para a
# VPS, com as portas 80 e 443 livres. Para testar sem TLS: SITE_ADDRESS=http://localhost.
SITE_ADDRESS=app.example.com
# URL pública, com https://: base dos links de e-mail, cookies e origens confiáveis.
APP_URL=https://app.example.com
# Um salto: o Caddy. Com outro proxy na frente (Cloudflare), aumente e ajuste o Caddyfile.
TRUSTED_PROXY_HOPS=1
# Portas publicadas pelo Caddy no host (só mude para testar em outra porta).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Imagem (opcional) -----------------------------------------------------------
# Imagem do app publicada num registry; sem isso, `docker compose build` constrói na VPS.
# APP_IMAGE=ghcr.io/seu-usuario/seu-saas:0.1.0

# --- Postgres (OBRIGATÓRIO, GERE) -----------------------------------------------
# Em produção o app recusa nas URLs: senha vazia, igual ao usuário, com menos de 16 caracteres ou
# começada por `change-me`. Isso inclui as senhas de desenvolvimento do docker/postgres/init.sql
# (iguais ao nome do papel), que ele usa se rodar à mão sem as variáveis do psql: em Postgres
# gerenciado, passe-as com -v ou corrija depois com ALTER ROLE.
# Superusuário: só o init e a administração. Não vai para o app.
POSTGRES_SUPERUSER_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# bizu_owner: dono das tabelas, usado pelas migrations (DIRECT_URL).
BIZU_OWNER_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# bizu_app: runtime do app, sem BYPASSRLS (DATABASE_URL).
BIZU_APP_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# bizu_backup: opcional, para o perfil `backup`. Defina ANTES do primeiro start do Postgres; as
# senhas só são lidas na criação do volume (docs/context/tech/14-deploy.md explica como criar depois).
# BIZU_BACKUP_PASSWORD=

# --- Segredos (OBRIGATÓRIO, GERE) ------------------------------------------------
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# openssl rand -base64 32 (exatamente 32 bytes em base64). Perdê-la torna ilegíveis as credenciais
# de provedores guardadas por tenant: guarde uma cópia fora do servidor.
CREDENTIALS_ENCRYPTION_KEY=Y2hhbmdlLW1lLWNyZWRlbnRpYWxzLWtleS0zMmJ5dGU=
# Só durante a rotação da chave acima (docs/context/tech/26-seguranca.md).
# CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
# CREDENTIALS_KEY_VERSION=1
# openssl rand -hex 16
AUDIT_SALT=change-me-generate-with-openssl-rand-hex-16

# --- E-mail (OBRIGATÓRIO) -------------------------------------------------------
# smtp | resend. `memory` é recusado em produção.
EMAIL_PROVIDER=smtp
EMAIL_FROM="Meu SaaS <no-reply@example.com>"
# EMAIL_REPLY_TO=
# Com smtp:
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true na porta 465 (TLS direto); false na 587 (STARTTLS).
SMTP_SECURE=false
# Com resend (EMAIL_PROVIDER=resend); o webhook fica em /api/webhooks/email/resend:
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# --- Jobs e rate limit -----------------------------------------------------------
# inline (padrão): a fila roda dentro do app. Ao ligar o perfil `worker` (COMPOSE_PROFILES=worker),
# DEFINA off aqui, senão app e worker consomem a mesma fila (o app avisa com `warn` no log e em /admin).
# APP_JOBS_MODE=off
# postgres é obrigatório em produção; memory derruba a subida.
RATE_LIMIT_STORE=postgres

# --- Segurança -------------------------------------------------------------------
# true: a CSP só relata violações em /api/csp-report. Valide as telas reais e mude para false.
CSP_REPORT_ONLY=true

# --- Pagamentos (módulos; vazio = só planos gratuitos e trial) ---------------------
PAYMENT_PROVIDERS=
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=
# Padrão da stack de produção: false (API real). Use true só para testar com a conta sandbox.
ASAAS_SANDBOX=false

# --- Arquivos (módulo) -----------------------------------------------------------
# local grava no volume `storage` (/data/storage); s3 usa um bucket privado.
STORAGE_PROVIDER=local
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10

# --- Observabilidade (opcional) --------------------------------------------------
LOG_LEVEL=info
# SENTRY_DSN=

# --- Backup (perfil `backup`: COMPOSE_PROFILES=backup) -----------------------------
# Chave PÚBLICA do `age` (age-keygen); a privada fica fora do servidor.
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_INTERVAL_HOURS=24
# BACKUP_KEEP_DAYS=14
