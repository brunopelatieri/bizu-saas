# Variáveis do docker/compose.prod.yml (stack de produção). Copie para docker/.env.prod, que o
# git ignora, e preencha. Só este arquivo é versionado, com valores de exemplo.
#
#   cp docker/.env.prod.example docker/.env.prod
#   docker compose --env-file docker/.env.prod -f docker/compose.prod.yml config   # confere tudo
#
# No Portainer, cole estas variáveis na seção "Environment variables" da stack.
#
# Como ler este arquivo
#   OBRIGATÓRIO  linha ativa: o compose ou o app não sobe sem ela. Preencha antes do 1º `up`.
#   GERE         não use o valor de exemplo: gere um novo (o comando está no comentário).
#   OPCIONAL     linha comentada (`# VAR=`): tire o `#` e preencha só se for usar o recurso.
#   FIXA         o compose já define o valor: não precisa (nem adianta) pôr aqui. Listadas no
#                fim, em comentário, só para você saber que existem.
#
# O app RECUSA subir em produção com os valores de exemplo de BETTER_AUTH_SECRET,
# CREDENTIALS_ENCRYPTION_KEY e AUDIT_SALT (qualquer valor que comece por `change-me`), com
# RATE_LIMIT_STORE=memory ou com EMAIL_PROVIDER=memory. Gere valores novos para tudo que está
# marcado como OBRIGATÓRIO e GERE.
#
# Senhas entram em URLs de conexão: use só letras e números (`openssl rand -hex 24`). As senhas de
# bizu_owner, bizu_app e bizu_backup que começam por `change-me` ou têm menos de 16 caracteres são
# recusadas (o init do banco falha e o app não sobe). Troque também a do superusuário: ela não é
# verificada.
#
# Roteiro mínimo para o primeiro deploy:
#   1. Domínio, e-mail e os três blocos "GERE" abaixo (Postgres, segredos).
#   2. `up -d postgres`, depois `--profile tools run --rm migrate`, depois `up -d app caddy`.
#   3. Só então ligue o que é opcional (pagamentos, S3, Sentry, worker, backup).

# --- Domínio e proxy (OBRIGATÓRIO) ---------------------------------------------
# Domínio servido pelo Caddy, que obtém o certificado sozinho. O DNS precisa apontar para a
# VPS, com as portas 80 e 443 livres. Para testar sem TLS: SITE_ADDRESS=http://localhost.
SITE_ADDRESS=app.example.com
# URL pública, com https://: base dos links de e-mail, cookies e origens confiáveis.
# Tem de bater com SITE_ADDRESS; se divergir, login e links de e-mail quebram.
APP_URL=https://app.example.com
# Quantos proxies confiáveis ficam na frente do app. 1 = só o Caddy. Com outro proxy antes dele
# (Cloudflare), aumente e ajuste o Caddyfile; com valor errado, todos dividem o mesmo rate limit.
TRUSTED_PROXY_HOPS=1
# Portas publicadas pelo Caddy no host (só mude para testar em outra porta).
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Imagem (OPCIONAL) -----------------------------------------------------------
# Imagem do app publicada num registry; sem isso, `docker compose build` constrói na VPS.
# APP_IMAGE=ghcr.io/seu-usuario/seu-saas:0.1.0

# --- Perfis do compose (OPCIONAL) ------------------------------------------------
# Liga serviços extras separados por vírgula: `worker` (fila em processo próprio) e `backup`
# (pg_dump cifrado). Veja as seções "Jobs" e "Backup" antes de ligar.
# COMPOSE_PROFILES=worker,backup

# --- Postgres (OBRIGATÓRIO, GERE) -----------------------------------------------
# Em produção o app recusa nas URLs: senha vazia, igual ao usuário, com menos de 16 caracteres ou
# começada por `change-me`. Isso inclui as senhas de desenvolvimento do docker/postgres/init.sql
# (iguais ao nome do papel), que ele usa se rodar à mão sem as variáveis do psql: em Postgres
# gerenciado, passe-as com -v ou corrija depois com ALTER ROLE.
# Atenção: as senhas só são lidas na criação do volume do Postgres. Trocá-las depois exige
# ALTER ROLE no banco, não basta mudar este arquivo.
# Gere cada uma com: openssl rand -hex 24
# Superusuário: só o init e a administração. Não vai para o app.
POSTGRES_SUPERUSER_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# bizu_owner: dono das tabelas, usado pelas migrations (DIRECT_URL). Só o serviço `migrate` a recebe.
BIZU_OWNER_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# bizu_app: runtime do app, sem BYPASSRLS (DATABASE_URL). É ela que protege o isolamento entre tenants.
BIZU_APP_PASSWORD=change-me-generate-with-openssl-rand-hex-24
# bizu_backup: OPCIONAL, para o perfil `backup`. Defina ANTES do primeiro start do Postgres; as
# senhas só são lidas na criação do volume (docs/context/tech/14-deploy.md explica como criar depois).
# BIZU_BACKUP_PASSWORD=

# --- Segredos (OBRIGATÓRIO, GERE) ------------------------------------------------
# Assina cookies e tokens de sessão. Trocar desloga todo mundo.
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-generate-with-openssl-rand-base64-32
# Cifra as credenciais de provedores guardadas por tenant.
# openssl rand -base64 32 (exatamente 32 bytes em base64). Perdê-la torna ilegíveis essas
# credenciais: guarde uma cópia fora do servidor.
CREDENTIALS_ENCRYPTION_KEY=Y2hhbmdlLW1lLWNyZWRlbnRpYWxzLWtleS0zMmJ5dGU=
# Só durante a rotação da chave acima (docs/context/tech/26-seguranca.md): ponha aqui a chave
# antiga, a nova em CREDENTIALS_ENCRYPTION_KEY e some 1 à versão. Fora da rotação, deixe como está.
# CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
# CREDENTIALS_KEY_VERSION=1
# Sal do hash de IP no log de auditoria. Trocar impede comparar IPs com registros antigos.
# openssl rand -hex 16
AUDIT_SALT=change-me-generate-with-openssl-rand-hex-16

# --- E-mail (OBRIGATÓRIO) -------------------------------------------------------
# Sem e-mail ninguém verifica a conta nem recupera a senha. `memory` é recusado em produção.
# smtp | resend
EMAIL_PROVIDER=smtp
# Remetente exibido. O domínio precisa estar autenticado (SPF/DKIM) no provedor, senão cai no spam.
EMAIL_FROM="Meu SaaS <no-reply@example.com>"
# Endereço de resposta, se for diferente do remetente.
# EMAIL_REPLY_TO=
# Com smtp (EMAIL_PROVIDER=smtp): host é obrigatório; usuário e senha, se o servidor exigir.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# true na porta 465 (TLS direto); false na 587 (STARTTLS).
SMTP_SECURE=false
# Com resend (EMAIL_PROVIDER=resend): a chave é obrigatória; o webhook de bounces fica em
# /api/webhooks/email/resend e o segredo vem do painel do Resend.
# RESEND_API_KEY=
# RESEND_WEBHOOK_SECRET=

# --- Jobs e rate limit -----------------------------------------------------------
# inline (padrão): a fila roda dentro do app. Ao ligar o perfil `worker` (COMPOSE_PROFILES=worker),
# DEFINA off aqui, senão app e worker consomem a mesma fila (o app avisa com `warn` no log e em /admin).
# O nome é APP_JOBS_MODE aqui; dentro do container vira JOBS_MODE.
# APP_JOBS_MODE=off
# postgres é obrigatório em produção; memory derruba a subida (cada réplica contaria sozinha).
RATE_LIMIT_STORE=postgres

# --- Segurança -------------------------------------------------------------------
# true: a CSP só relata violações em /api/csp-report. Valide as telas reais e mude para false
# para o navegador passar a bloquear.
CSP_REPORT_ONLY=true

# --- Pagamentos (módulos; vazio = só planos gratuitos e trial) ---------------------
# Lista separada por vírgula com os módulos ativos. Hoje só existe `stripe`. Um id sem módulo em
# src/lib/payments/providers/ derruba a subida. Sem nenhum, o sistema segue com planos gratuitos.
PAYMENT_PROVIDERS=
# Com stripe em PAYMENT_PROVIDERS as duas são obrigatórias. Use as chaves LIVE (sk_live_...) só em
# produção real; sk_test_... só para validar o fluxo.
# Webhook no painel da Stripe: https://SEU-DOMINIO/api/webhooks/payments/stripe (o `whsec_...` dele).
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Outro provedor traz as próprias variáveis junto com o módulo (src/lib/payments/providers/README.md).

# --- Arquivos (módulo) -----------------------------------------------------------
# local grava no volume `storage` (/data/storage); s3 usa um bucket privado.
STORAGE_PROVIDER=local
# Com s3 (STORAGE_PROVIDER=s3) as quatro primeiras são obrigatórias. S3_ENDPOINT só para
# compatíveis (Cloudflare R2, MinIO, Backblaze); na AWS, deixe vazio. Bucket sempre privado.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# Teto de um upload, em MB (1 a 100); vale também como limite de corpo da rota. Se o Caddy ou
# outro proxy limitar o corpo, mantenha-o igual ou maior.
MAX_UPLOAD_MB=10

# --- Observabilidade (OPCIONAL) --------------------------------------------------
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Com o DSN, os erros de logError vão ao Sentry. Sem ele, nada é carregado.
# SENTRY_DSN=

# --- Backup (OPCIONAL; perfil `backup`: COMPOSE_PROFILES=backup) -------------------
# Precisa de BIZU_BACKUP_PASSWORD (acima, definida antes do 1º start do Postgres) e da chave abaixo;
# sem elas o serviço recusa subir. Restauração e teste mensal: docs/context/tech/14-deploy.md.
# Chave PÚBLICA do `age` (age-keygen); a privada fica fora do servidor. Sem a privada, o backup
# não se restaura.
# BACKUP_AGE_RECIPIENT=age1...
# Intervalo entre dumps, em horas.
# BACKUP_INTERVAL_HOURS=24
# Quantos dias de backup ficam no volume antes de serem apagados.
# BACKUP_KEEP_DAYS=14

# --- FIXAS: o compose define; NÃO ponha aqui -----------------------------------------
# Existem no app (src/lib/env.ts), mas o docker/compose.prod.yml já as fixa. Estão em comentário
# só para a lista ficar completa; descomentar não tem efeito.
# NODE_ENV=production                      # sempre production na stack
# PORT=3000                                # porta interna; o Caddy publica 80/443
# DATABASE_URL=...                         # montada com BIZU_APP_PASSWORD (bizu_app)
# DIRECT_URL=...                           # app/worker: bizu_app; migrate: bizu_owner
# JOBS_MODE=...                            # vem de APP_JOBS_MODE (app), worker ou off (migrate)
# STORAGE_LOCAL_DIR=/data/storage          # volume `storage`
#
# FORA da stack: valem só ao rodar `npm run db:seed` à mão, nunca vão para os containers. Em
# produção o seed é recusado, salvo com SEED_ALLOW_PRODUCTION=1 e uma senha própria.
# SEED_PASSWORD=...                        # mínimo de 10 caracteres
# SEED_ALLOW_PRODUCTION=
