{
	"$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
	"files": {
		"includes": [
			"src/**/*.ts",
			"src/**/*.tsx",
			"tests/**/*.ts",
			"!src/components/ui"
		]
	},
	"formatter": {
		"enabled": false
	},
	"assist": {
		"enabled": false
	},
	"linter": {
		"enabled": true,
		"domains": {
			"react": "recommended"
		},
		"rules": {
			"preset": "recommended"
		}
	},
	"overrides": [
		{
			"includes": [
				"src/api/me.ts",
				"src/api/tenant.ts",
				"src/api/team.ts",
				"src/api/roles.ts",
				"src/api/invitations.ts",
				"src/api/permissions.ts"
			],
			"linter": {
				"rules": {
					"style": {
						"noRestrictedImports": {
							"level": "error",
							"options": {
								"paths": {
									"@/db": "Rota de tenant não acessa o banco direto: use src/lib/tenant/ com withTenant."
								}
							}
						}
					}
				}
			}
		}
	]
}
