{
  "name": "bizu-saas",
  "version": "0.1.0",
  "description": "Ponto de partida open source para SaaS multi-tenant: quatro níveis de login, trial, pagamentos em módulos, Drizzle em qualquer Postgres.",
  "private": true,
  "homepage": "https://github.com/brunopelatieri/bizu-saas#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/brunopelatieri/bizu-saas.git"
  },
  "bugs": {
    "url": "https://github.com/brunopelatieri/bizu-saas/issues"
  },
  "author": "Bruno Pelatieri Goulart",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.19"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node --env-file-if-exists=.env.local -e \"process.env.NODE_ENV='production'; import('./build/server/index.js')\"",
    "typecheck": "react-router typegen && tsc -p tsconfig.app.json && tsc -p tsconfig.node.json",
    "lint": "biome lint src tests",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx --tsconfig tsconfig.app.json src/db/seed.ts",
    "test:db": "vitest run --config vitest.db.config.ts",
    "jobs:install": "tsx --tsconfig tsconfig.app.json src/jobs/install.ts",
    "email:preview": "tsx --tsconfig tsconfig.app.json src/lib/email/preview.ts",
    "check:module-removal": "node scripts/check-module-removal.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1164.0",
    "@base-ui/react": "^1.6.0",
    "@better-auth/drizzle-adapter": "^1.7.18",
    "@better-auth/utils": "^0.5.1",
    "@hono/node-server": "^2.1.6",
    "@hono/zod-validator": "^0.9.1",
    "@hookform/resolvers": "^7.0.3",
    "@react-router/node": "^8.5.1",
    "@sentry/node": "^11.11.0",
    "@tanstack/react-query": "^5.101.0",
    "better-auth": "^1.7.18",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.9",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.16",
    "isbot": "^5.1.43",
    "lucide-react": "^1.21.0",
    "nodemailer": "^10.3.1",
    "pg-boss": "^12.38.1",
    "pino": "^10.4.0",
    "postgres": "^4.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "^7.80.0",
    "react-router": "^8.5.1",
    "react-router-hono-server": "^4.1.7",
    "resend": "^6.37.0",
    "sonner": "^2.0.7",
    "stripe": "^23.1.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.5",
    "@react-router/dev": "^8.5.1",
    "@tailwindcss/vite": "^4.1.17",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "drizzle-kit": "^0.31.11",
    "pino-pretty": "^13.2.0",
    "tailwindcss": "^4.1.17",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "react-router-hono-server": {
      "@hono/node-server": "$@hono/node-server"
    }
  }
}
