# Copie para .env.local (ignorado pelo git). Só este arquivo é versionado, com
# valores de exemplo. Tudo é validado em src/lib/env.ts na inicialização.
# Variáveis VITE_* vão para o navegador: só valores públicos.

# --- Aplicação ---------------------------------------------------------------
NODE_ENV=development
# Porta do servidor único em produção (em dev o Vite usa 5173).
PORT=3000
# URL pública do app: base dos links de e-mail, cookies e origens confiáveis.
APP_URL=http://localhost:5173
# Quantidade de reverse proxies confiáveis na frente do app. 0 sem proxy; 1 atrás de um.
TRUSTED_PROXY_HOPS=0
# Nome exibido no navegador (público).
VITE_APP_NAME=Bizu SaaS

# --- Postgres (Drizzle) ------------------------------------------------------
# Porta 15432: mapeamento do docker-compose (evita conflito no Windows).
# Os papéis são criados por docker/postgres/init.sql.
# Runtime: bizu_app, sem BYPASSRLS (o Row Level Security vale para ele).
DATABASE_URL=postgresql://bizu_app:bizu_app@localhost:15432/bizu
# Migrations, seed e instalação da fila: bizu_owner, dono das tabelas.
DIRECT_URL=postgresql://bizu_owner:bizu_owner@localhost:15432/bizu
# Em pooler no modo transaction (PgBouncer), acrescente ?prepare=false à DATABASE_URL.

# --- Segredos (gere valores novos; em produção os de exemplo são recusados) ----
# openssl rand -base64 32
BETTER_AUTH_SECRET=change-me-better-auth-secret-with-32-bytes
# openssl rand -base64 32 (32 bytes em base64; cifra credenciais de provedores por tenant)
CREDENTIALS_ENCRYPTION_KEY=Y2hhbmdlLW1lLWNyZWRlbnRpYWxzLWtleS0zMmJ5dGU=
# Só durante a rotação da chave acima (docs/context/tech/26-seguranca.md).
CREDENTIALS_ENCRYPTION_KEY_PREVIOUS=
CREDENTIALS_KEY_VERSION=1
# openssl rand -hex 16 (hash de IP no log de auditoria)
AUDIT_SALT=change-me-audit-salt

# --- E-mail ------------------------------------------------------------------
# smtp | resend | memory (memory: só testes, nada é enviado)
EMAIL_PROVIDER=smtp
EMAIL_FROM="Bizu SaaS <no-reply@localhost>"
EMAIL_REPLY_TO=
# Mailpit do docker-compose: captura tudo em http://localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=false
# Só com EMAIL_PROVIDER=resend
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# --- Jobs e rate limit -------------------------------------------------------
# inline (fila no mesmo processo) | worker (só workers) | off (só enfileira)
JOBS_MODE=inline
# memory (só desenvolvimento) | postgres (obrigatório em produção; tabela rate_limit_bucket)
RATE_LIMIT_STORE=memory

# --- Pagamentos (módulos; vazio = só planos gratuitos) -----------------------
# Lista separada por vírgula com os módulos ativos de src/lib/payments/providers/.
PAYMENT_PROVIDERS=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
ASAAS_SANDBOX=true
# Módulos futuros
MERCADOPAGO_ACCESS_TOKEN=
MERCADOPAGO_WEBHOOK_SECRET=
PAGARME_SECRET_KEY=
PAGARME_WEBHOOK_SECRET=
PAGBANK_TOKEN=
PAGBANK_SANDBOX=true

# --- Arquivos (módulo) -------------------------------------------------------
# local | s3
STORAGE_PROVIDER=local
STORAGE_LOCAL_DIR=.data/storage
S3_BUCKET=
S3_REGION=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Teto de um upload, em MB (1 a 100). Vale também como limite de corpo da rota.
MAX_UPLOAD_MB=10

# --- Segurança, seed e observabilidade ---------------------------------------
# true: a CSP só relata violações em /api/csp-report. false: o navegador bloqueia.
CSP_REPORT_ONLY=true
# Senha única dos usuários do seed (`npm run db:seed`, mínimo de 10 caracteres). Só para dev:
# troque-a se o banco for acessível de fora. SEED_ALLOW_PRODUCTION=1 libera o seed em produção,
# onde este valor de exemplo é recusado.
SEED_PASSWORD=Bizu-seed-2026!
SEED_ALLOW_PRODUCTION=
# fatal | error | warn | info | debug | trace
LOG_LEVEL=info
# Opcional: com o DSN, os erros de logError vão ao Sentry (src/lib/monitoring/sentry). Sem ele, nada é carregado.
SENTRY_DSN=
