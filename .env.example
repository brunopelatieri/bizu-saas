# Postgres — Drizzle ORM (server-only). Pode ser local, VPS ou o do Supabase.
# Porta 15432: mapeamento local do docker-compose (evita conflito no Windows)
DATABASE_URL=postgresql://portal:portal@localhost:15432/portal
DIRECT_URL=postgresql://portal:portal@localhost:15432/portal

# Postgres do Supabase: copie as URLs do painel em Connect.
# No transaction pooler (porta 6543), prepare=false desliga prepared statements.
# DATABASE_URL=postgresql://postgres.your-project-ref:password@your-pooler-host:6543/postgres?prepare=false
# DIRECT_URL=postgresql://postgres.your-project-ref:password@your-pooler-host:5432/postgres

# Servidor único — React Router SSR + Hono API
PORT=3000

# Quantidade de reverse proxies confiáveis na frente do app. Deixe 0 sem proxy.
# Atrás de proxy, com 0 todos os clientes dividem o mesmo rate limit.
TRUSTED_PROXY_HOPS=0

# Supabase — Auth + Storage. Valores públicos: vão para o bundle no build.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-publishable-key
